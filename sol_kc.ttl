@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix sol_kc:  <https://cornelka.github.io/sol_kc.ttl>.
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# ─────────────────────────────────────────────
#  Classes
# ─────────────────────────────────────────────

sol_kc:Person a rdfs:Class ;
    rdfs:label   "Person"@en ;
    rdfs:comment "A human being identified by name, contact details, and social connections."@en ;
    rdfs:subClassOf foaf:Person .

sol_kc:Dog a rdfs:Class ;
    rdfs:label   "Dog"@en ;
    rdfs:comment "A domestic dog (Canis lupus familiaris) kept as a pet."@en .

sol_kc:Photo a rdfs:Class;
    rdfs:label   "Photograph"@en ;
    rdfs:comment "An image created by light falling on a photosensitive surface, usually photographic film or an electronic image sensor."@en ;
    rdfs:subClassOf foaf:Image .

sol_kc:GenPhoto a rdfs:Class;
    rdfs:label   "Generated image"@en ;
    rdfs:comment "An image generated by an artificial process"@en ;
    rdfs:subClassOf sol_kc:Photo.


# ─────────────────────────────────────────────
#  Properties of Person
# ─────────────────────────────────────────────

sol_kc:givenName a rdf:Property ;
    rdfs:label          "given name"@en ;
    rdfs:comment        "The first (given) name of a person."@en ;
    rdfs:domain         sol_kc:Person ;
    rdfs:range          xsd:string ;
    rdfs:subPropertyOf  foaf:givenName .

sol_kc:familyName a rdf:Property ;
    rdfs:label          "family name"@en ;
    rdfs:comment        "The surname (family name) of a person."@en ;
    rdfs:domain         sol_kc:Person ;
    rdfs:range          xsd:string ;
    rdfs:subPropertyOf  foaf:familyName .

sol_kc:birthday a rdf:Property ;
    rdfs:label          "birthday"@en ;
    rdfs:comment        "The date of birth of a person."@en ;
    rdfs:domain         sol_kc:Person ;
    rdfs:range          xsd:date ;
    rdfs:subPropertyOf  foaf:birthday .

sol_kc:mbox a rdf:Property ;
    rdfs:label          "mailbox"@en ;
    rdfs:comment        "A personal e-mail address (mailbox IRI) belonging to a person."@en ;
    rdfs:subPropertyOf  foaf:mbox ;
    rdfs:domain         sol_kc:Person ;
    rdfs:range          rdfs:Resource .

sol_kc:interest a rdf:Property ;
    rdfs:label          "interest"@en ;
    rdfs:comment        "A resource (topic, website, or activity) that a person is interested in."@en ;
    rdfs:domain         sol_kc:Person ;
    rdfs:range          rdfs:Resource ;
    rdfs:subPropertyOf  foaf:interest .

sol_kc:knows a rdf:Property ;
    rdfs:label          "knows"@en ;
    rdfs:comment        "Indicates that this person has acquaintance with another person."@en ;
    rdfs:domain         sol_kc:Person ;
    rdfs:range          sol_kc:Person ;
    rdfs:subPropertyOf  foaf:knows .

sol_kc:name a rdf:Property ;
    rdfs:label          "full name"@en ;
    rdfs:comment        "The full name of a person or dog."@en ;
    rdfs:range          xsd:string ;
    rdfs:subPropertyOf  foaf:name .


# ─────────────────────────────────────────────
#  Properties of Dog
# ─────────────────────────────────────────────
sol_kc:dogname a rdf:Property ;
    rdfs:label   "name"@en ;
    rdfs:comment "The given name of a dog."@en ;
    rdfs:domain  sol_kc:Dog ;
    rdfs:range   xsd:string .

sol_kc:breed a rdf:Property ;
    rdfs:label   "breed"@en ;
    rdfs:comment "The breed of a dog (e.g. Golden Retriever)."@en ;
    rdfs:domain  sol_kc:Dog ;
    rdfs:range   xsd:string .

sol_kc:color a rdf:Property ;
    rdfs:label   "color"@en ;
    rdfs:comment "The predominant coat color of a dog."@en ;
    rdfs:domain  sol_kc:Dog ;
    rdfs:range   xsd:string .

sol_kc:owner a rdf:Property ;
    rdfs:label   "owner"@en ;
    rdfs:comment "The person who owns and is responsible for a dog."@en ;
    rdfs:domain  sol_kc:Dog ;
    rdfs:range   sol_kc:Person .

# ─────────────────────────────────────────────
#  Properties of Photo
# ─────────────────────────────────────────────

sol_kc:title a rdf:Property ;
    rdfs:label   "title"@en ;
    rdfs:comment "The name or title of a photo."@en ;
    rdfs:domain  sol_kc:Photo ;
    rdfs:range   xsd:string .

sol_kc:takenby a rdf:Property ;
    rdfs:label          "creator"@en ;
    rdfs:comment        "The person who made the photo."@en ;
    rdfs:domain         sol_kc:Photo ;
    rdfs:range          sol_kc:Person;
    rdfs:subPropertyOf  foaf:maker.

sol_kc:depicts a rdf:Property ;
    rdfs:label          "depicts"@en ;
    rdfs:comment        "Person shown in the photo."@en ;
    rdfs:domain         sol_kc:Photo ;
    rdfs:range          rdfs:Resource ;
    rdfs:subPropertyOf  foaf:depicts.

sol_kc:location a rdf:Property ;
    rdfs:label   "location"@en ;
    rdfs:comment "Location where the foto was made."@en ;
    rdfs:domain  sol_kc:Photo ;
    rdfs:range   xsd:string.

sol_kc:description a rdf:Property ;
    rdfs:label   "description"@en ;
    rdfs:comment "Description of the photo"@en ;
    rdfs:domain  sol_kc:Photo ;
    rdfs:range   xsd:string.

sol_kc:url a rdf:Property ;
    rdfs:label   "url"@en ;
    rdfs:comment "Download location where you can find the photo"@en ;
    rdfs:domain  sol_kc:Photo ;
    rdfs:range   rdfs:Resource.

sol_kc:publicationdate a rdf:Property ;
    rdfs:label   "publicationdate"@en ;
    rdfs:comment "Date when the photo was publicised"@en ;
    rdfs:domain  sol_kc:Photo ;
    rdfs:range   xsd:date .

# ─────────────────────────────────────────────
#  Properties of GenPhoto
# ─────────────────────────────────────────────
sol_kc:createdby a rdf:Property ;
    rdfs:label   "createdby"@en ;
    rdfs:comment "The process that created a the photo."@en ;
    rdfs:domain  sol_kc:GenPhoto ;
    rdfs:range   xsd:string ;
    rdfs:subPropertyOf  foaf:maker .